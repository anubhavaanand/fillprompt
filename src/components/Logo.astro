---
// Brand mark: square brackets around a highlighter block, a blank waiting to be filled.
interface Props {
  size?: number;
}
const { size = 26 } = Astro.props;
---

<span class="inline-flex items-center gap-2">
  <svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
    <rect x="12.5" y="11" width="7" height="10" fill="#ffd83d"></rect>
    <path
      d="M12 6.5H7.5v19H12M20 6.5h4.5v19H20"
      fill="none"
      stroke="currentColor"
      stroke-width="3"
      stroke-linecap="square"></path>
  </svg>
  <span class="font-display text-[19px] font-extrabold leading-none tracking-[-0.03em]">
    mytemplate<span class="font-mono text-[12px] font-medium tracking-normal opacity-60">.my</span>
  </span>
</span>
