---
import type { ImagePrompt } from '../lib/data';
import { categoryLabels, href, ui, type Lang } from '../i18n';
interface Props {
  p: ImagePrompt;
  lang: Lang;
  eager?: boolean;
}
const { p, lang, eager = false } = Astro.props;
---

<a href={href(lang, `/prompt/${p.slug}`)} class="tile group block">
  <span class="tile-img">
    <img
      src={p.images[0]}
      alt={p.title}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      referrerpolicy="no-referrer"
      class="block min-h-20 w-full"
      onerror="this.closest('a').style.display='none'"
    />
    {
      p.images.length > 1 && (
        <span class="absolute bottom-0 right-0 bg-ink px-1.5 py-0.5 font-mono text-[10px] text-paper">
          {ui[lang].images.count(p.images.length)}
        </span>
      )
    }
  </span>
  <span class="mt-2.5 block">
    <span class="line-clamp-2 block text-[15px] font-semibold leading-snug">{p.title}</span>
    <span class="label mt-1 block">{categoryLabels[lang][p.cats[0]]} / {p.model}</span>
  </span>
</a>
