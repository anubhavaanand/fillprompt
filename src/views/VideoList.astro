---
// Paginated grid of video prompts: the full list, or one AI model when `model` (a slug) is set.
import Base from '../layouts/Base.astro';
import VideoCard from '../components/VideoCard.astro';
import Pagination from '../components/Pagination.astro';
import QuickFilter from '../components/QuickFilter.astro';
import { videos, videoModels, fmt } from '../lib/data';
import { ui, href, type Lang } from '../i18n';
import { itemList } from '../lib/seo';

interface Props {
  lang: Lang;
  page: any;
  model?: string;
}
const { lang, page, model } = Astro.props;
const t = ui[lang];
const tv = t.videos;
const current = videoModels.find((m) => m.slug === model);
const suffix = page.currentPage > 1 ? `, ${t.page(page.currentPage)}` : '';
const title = (current ? tv.modelMetaTitle(current.label) : tv.metaTitle) + suffix;
const description = current ? tv.modelMetaDesc(current.count, current.label) : tv.metaDesc(videos.length);
const crumbs: [string, string][] = current
  ? [[tv.title, '/videos'], [current.label, `/video-model/${current.slug}`]]
  : [[tv.title, '/videos']];
---

<Base lang={lang} title={title} description={description} crumbs={crumbs} schema={[itemList(lang, page.data.map((v) => `/video/${v.slug}`))]}>
  <div class="wrap pt-10">
    {
      current ? (
        <p class="label">
          <a href={href(lang, '/videos')} class="hover:text-ink">{tv.title}</a> / {tv.crumbModel}
        </p>
      ) : (
        <p class="label">{t.collection}</p>
      )
    }
    <h1 class="display mt-2 text-4xl sm:text-6xl">{current ? current.label : tv.title}</h1>
    <p class="mt-3 max-w-xl text-muted">{current ? tv.modelLead(current.count, current.label) : tv.lead(videos.length)}</p>

    <p class="label mt-6">{tv.byModel}</p>
    <div class="mt-2 flex flex-wrap gap-2">
      <a href={href(lang, '/videos')} class:list={['chip', !current && 'chip-on']}>
        {t.all} <span class="n">{fmt(videos.length)}</span>
      </a>
      {
        videoModels.map((m) => (
          <a href={href(lang, `/video-model/${m.slug}`)} class:list={['chip', m.slug === model && 'chip-on']}>
            {m.label} <span class="n">{fmt(m.count)}</span>
          </a>
        ))
      }
    </div>
    <QuickFilter lang={lang} kind="v" model={current?.label} />

    <div id="filter-static">
      <div class="mt-8 grid grid-cols-2 gap-x-5 gap-y-7 border-t border-ink pt-6 md:grid-cols-3 lg:grid-cols-4">
        {page.data.map((v, i) => <VideoCard v={v} lang={lang} eager={i < 4} />)}
      </div>
      <Pagination page={page} lang={lang} />
    </div>
  </div>
</Base>
