---
import Base from '../layouts/Base.astro';
import { ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = ui[lang].donate;

// The owner's DuitNow QRs: both pay the same person. The page shows the code alone; "Save" gives
// the bank's full card, which banking apps can read from the gallery. Files live in public/donate.
const RECIPIENT = 'Muhammad Wannor Razzuwan';
const KOFI = 'https://ko-fi.com/mwrazzuwan';
const QRS = [
  { bank: 'Public Bank', code: '/donate/qr-public-bank.png', file: '/donate/duitnow-qr.jpg', download: 'mytemplate-DuitNow-QR-Public-Bank.jpg' },
  { bank: 'AmBank Islamic', code: '/donate/qr-ambank.png', file: '/donate/duitnow-qr-ambank.jpg', download: 'mytemplate-DuitNow-QR-AmBank-Islamic.jpg' },
];
---

<Base lang={lang} title={d.metaTitle} description={d.metaDesc} crumbs={[[ui[lang].nav.donate, '/donate']]}>
  <div class="wrap max-w-5xl pt-10">
    <p class="label"><span class="text-hot" aria-hidden="true">♥</span> {d.label}</p>
    <h1 class="display mt-2 text-4xl sm:text-6xl">
      {d.h1a} <mark>{d.h1b}</mark>
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">
      {d.intro} <span class="font-semibold text-ink">{d.thanks}</span>
    </p>

    <div class="mt-10 grid gap-6 lg:grid-cols-[1.7fr_1fr]">
      <section aria-labelledby="qr-heading" class="border border-ink bg-surface">
        <div class="flex items-center gap-4 border-b border-ink p-4 sm:p-5">
          <img src="/donate/duitnow-logo.png" alt="" width="175" height="185" class="h-12 w-auto shrink-0" />
          <div class="min-w-0">
            <p class="label">01 · {d.qrSub}</p>
            <h2 id="qr-heading" class="font-display text-2xl font-extrabold tracking-[-0.03em]">{d.qrTitle}</h2>
          </div>
        </div>
        <p class="border-b border-line px-4 py-3 text-sm sm:px-5">
          <span class="text-muted">{d.payTo}</span> <strong>{RECIPIENT}</strong>
        </p>
        <div class="grid sm:grid-cols-2">
          {
            QRS.map((q, i) => (
              <figure class:list={['p-4 sm:p-5', i > 0 && 'border-t border-line sm:border-l sm:border-t-0']}>
                <div class="border border-ink/15 bg-white p-3">
                  <img src={q.code} alt={d.qrAlt(q.bank, RECIPIENT)} width="640" height="640" class="mx-auto block h-auto w-full max-w-[260px]" />
                </div>
                <figcaption class="mt-3 flex items-center justify-between gap-3">
                  <span>
                    <span class="block font-semibold">{q.bank}</span>
                    <span class="label block">DuitNow QR</span>
                  </span>
                  <a href={q.file} download={q.download} aria-label={d.saveLabel(q.bank)} class="btn shrink-0 !px-3 !py-2">
                    ↓ {d.save}
                  </a>
                </figcaption>
              </figure>
            ))
          }
        </div>
        <p class="border-t border-ink bg-mark/25 px-4 py-3 text-sm leading-relaxed sm:px-5">
          {d.check} <strong>{RECIPIENT}</strong>.
        </p>
      </section>

      <section aria-labelledby="kofi-heading" class="flex flex-col border border-ink bg-surface">
        <div class="border-b border-ink p-4 sm:p-5">
          <p class="label">02 · {d.kofiSub}</p>
          <h2 id="kofi-heading" class="font-display text-2xl font-extrabold tracking-[-0.03em]">{d.kofiTitle}</h2>
        </div>
        <div class="flex flex-1 flex-col p-4 sm:p-5">
          <p class="leading-relaxed text-muted">{d.kofiBody}</p>
          <a href={KOFI} target="_blank" rel="noopener noreferrer" class="mt-5 block border border-ink/15 bg-white p-3">
            <img src="/donate/qr-kofi.svg" alt={d.kofiQrAlt} width="640" height="640" class="mx-auto block h-auto w-full max-w-[200px]" />
          </a>
          <p class="label mt-2 text-center">{d.kofiScan}</p>
          <a href={KOFI} target="_blank" rel="noopener noreferrer" class="btn mt-5 w-full !py-3.5 text-base">{d.kofiCta}</a>
          <p class="mt-3 break-all font-mono text-xs text-muted">ko-fi.com/mwrazzuwan</p>
        </div>
      </section>
    </div>

    <div class="sec mt-14">
      <span class="label">03</span>
      <h2>{d.howTo}</h2>
    </div>
    <ol class="mt-2 grid md:grid-cols-3 md:gap-x-10">
      {
        d.steps.map(([title, text], i) => (
          <li class="grid grid-cols-[2.5rem_1fr] gap-x-2 border-b border-line py-4 md:border-b-0">
            <span class="label pt-1">0{i + 1}</span>
            <span>
              <span class="block font-semibold">{title}</span>
              <span class="mt-1 block text-sm leading-relaxed text-muted">{text}</span>
            </span>
          </li>
        ))
      }
    </ol>

    <p class="mt-10 border-t border-ink pt-4 text-sm text-muted">{d.optional}</p>
  </div>
</Base>
