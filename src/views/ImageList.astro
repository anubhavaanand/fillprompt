---
// Paginated image prompt grid: the full list, or one category when `cat` is set.
import Base from '../layouts/Base.astro';
import ImageCard from '../components/ImageCard.astro';
import CategoryChips from '../components/CategoryChips.astro';
import Pagination from '../components/Pagination.astro';
import { images } from '../lib/data';
import { ui, href, categoryLabels, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  page: any;
  cat?: string;
}
const { lang, page, cat } = Astro.props;
const t = ui[lang];
const label = cat ? categoryLabels[lang][cat] : '';
const suffix = page.currentPage > 1 ? `, ${t.page(page.currentPage)}` : '';
const title = (cat ? t.images.catMetaTitle(label) : t.images.metaTitle) + suffix;
const description = cat ? t.images.catMetaDesc(page.total, label) : t.images.metaDesc(images.length);
---

<Base lang={lang} title={title} description={description}>
  <div class="wrap pt-10">
    {
      cat ? (
        <p class="label">
          <a href={href(lang, '/images')} class="hover:text-ink">{t.images.title}</a> / {t.images.crumbCategory}
        </p>
      ) : (
        <p class="label">{t.collection}</p>
      )
    }
    <h1 class="display mt-2 text-4xl sm:text-6xl">{cat ? label : t.images.title}</h1>
    <p class="mt-3 max-w-xl text-muted">{cat ? t.images.catLead(page.total) : t.images.lead(images.length)}</p>
    <div class="mt-6"><CategoryChips lang={lang} active={cat} /></div>
    <div class="masonry mt-8 border-t border-ink pt-6">
      {page.data.map((p, i) => <ImageCard p={p} lang={lang} eager={i < 4} />)}
    </div>
    <Pagination page={page} lang={lang} />
  </div>
</Base>
