---
import Base from '../layouts/Base.astro';
import Pagination from '../components/Pagination.astro';
import { texts, excerpt, pad } from '../lib/data';
import { TEXT_PAGE } from '../lib/paths';
import { ui, href, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  page: any;
}
const { lang, page } = Astro.props;
const t = ui[lang];
const suffix = page.currentPage > 1 ? `, ${t.page(page.currentPage)}` : '';
---

<Base lang={lang} title={t.text.metaTitle + suffix} description={t.text.metaDesc(texts.length)}>
  <div class="wrap pt-10">
    <p class="label">{t.collection}</p>
    <h1 class="display mt-2 text-4xl sm:text-6xl">{t.text.title}</h1>
    <p class="mt-3 max-w-xl text-muted">{t.text.lead(texts.length)}</p>
    <div class="mt-8 grid border-t border-ink md:grid-cols-2 md:gap-x-10">
      {
        page.data.map((x, i) => (
          <a href={href(lang, `/text-prompt/${x.slug}`)} class="row grid grid-cols-[3.25rem_1fr] gap-x-2 px-1">
            <span class="label pt-1">{pad((page.currentPage - 1) * TEXT_PAGE + i + 1, 4)}</span>
            <span>
              <span class="block font-semibold leading-snug">{x.title}</span>
              <span class="mt-1 line-clamp-2 block text-sm text-muted">{excerpt(x.prompt, 150)}</span>
              <span class="label mt-1.5 block">{t.text.types[x.type] ?? x.type}{x.forDevs && ` / ${t.text.dev}`}</span>
            </span>
          </a>
        ))
      }
    </div>
    <Pagination page={page} lang={lang} />
  </div>
</Base>
