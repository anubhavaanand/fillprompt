---
// Paginated list of text prompts: all of them, one AI model (`model`, a slug) or one type (`type`).
import Base from '../layouts/Base.astro';
import Pagination from '../components/Pagination.astro';
import QuickFilter from '../components/QuickFilter.astro';
import { texts, textModels, excerpt, pad, fmt, TEXT_FILTERS, textFilterCounts } from '../lib/data';
import { TEXT_PAGE } from '../lib/paths';
import { ui, href, type Lang } from '../i18n';
import { itemList } from '../lib/seo';

interface Props {
  lang: Lang;
  page: any;
  type?: string;
  model?: string;
}
const { lang, page, type, model } = Astro.props;
const t = ui[lang];
const tt = t.text;
const typeLabel = (f: string) => (f === 'developer' ? tt.forDevs : (tt.types[f] ?? f));
const current = textModels.find((m) => m.slug === model);
const label = current ? current.label : type ? typeLabel(type) : '';
const suffix = page.currentPage > 1 ? `, ${t.page(page.currentPage)}` : '';
const typeMeta = type ? tt.typeMeta[type] : undefined;
const title = (current ? tt.modelMetaTitle(current.label) : type ? (typeMeta?.[0] ?? tt.typeMetaTitle(label)) : tt.metaTitle) + suffix;
const description = current
  ? tt.modelMetaDesc(current.count, current.label)
  : typeMeta
    ? typeMeta[1](page.total)
    : tt.metaDesc(texts.length);
const lead = current ? tt.modelLead(current.count, current.label) : type ? tt.typeLead(page.total, label) : tt.lead(texts.length);
const crumbs: [string, string][] = current
  ? [[tt.title, '/text'], [label, `/text-model/${current.slug}`]]
  : type
    ? [[tt.title, '/text'], [label, `/text-type/${type}`]]
    : [[tt.title, '/text']];
---

<Base lang={lang} title={title} description={description} crumbs={crumbs} schema={[itemList(lang, page.data.map((x) => `/text-prompt/${x.slug}`))]}>
  <div class="wrap pt-10">
    {
      label ? (
        <p class="label">
          <a href={href(lang, '/text')} class="hover:text-ink">{tt.title}</a> / {current ? tt.crumbModel : tt.crumbType}
        </p>
      ) : (
        <p class="label">{t.collection}</p>
      )
    }
    <h1 class="display mt-2 text-4xl sm:text-6xl">{label || tt.title}</h1>
    <p class="mt-3 max-w-xl text-muted">{lead}</p>

    <div class="mt-6 grid gap-x-10 gap-y-4 lg:grid-cols-2">
      <div>
        <p class="label">{tt.byModel}</p>
        <div class="mt-2 flex flex-wrap gap-2">
          <a href={href(lang, '/text')} class:list={['chip', !label && 'chip-on']}>
            {t.all} <span class="n">{fmt(texts.length)}</span>
          </a>
          {
            textModels.map((m) => (
              <a href={href(lang, `/text-model/${m.slug}`)} class:list={['chip', m.slug === model && 'chip-on']}>
                {m.label} <span class="n">{fmt(m.count)}</span>
              </a>
            ))
          }
        </div>
      </div>
      <div>
        <p class="label">{tt.byType}</p>
        <div class="mt-2 flex flex-wrap gap-2">
          {
            TEXT_FILTERS.filter((f) => textFilterCounts[f]).map((f) => (
              <a href={href(lang, `/text-type/${f}`)} class:list={['chip', f === type && 'chip-on']}>
                {typeLabel(f)} <span class="n">{fmt(textFilterCounts[f])}</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
    <QuickFilter lang={lang} kind="t" model={current?.label} />

    <div id="filter-static">
      <div class="mt-8 grid border-t border-ink md:grid-cols-2 md:gap-x-10">
        {
          page.data.map((x, i) => (
            <a href={href(lang, `/text-prompt/${x.slug}`)} class="row grid grid-cols-[3.25rem_1fr] gap-x-2 px-1">
              <span class="label pt-1">{pad((page.currentPage - 1) * TEXT_PAGE + i + 1, 4)}</span>
              <span>
                <span class="block font-semibold leading-snug">{x.title}</span>
                <span class="mt-1 line-clamp-2 block text-sm text-muted">{x.desc || excerpt(x.prompt, 150)}</span>
                <span class="label mt-1.5 block">
                  <span class="text-ink">{x.model}</span> / {tt.types[x.type] ?? x.type}{x.forDevs && x.type !== 'agent' && ` / ${tt.dev}`}
                </span>
              </span>
            </a>
          ))
        }
      </div>
      <Pagination page={page} lang={lang} />
    </div>
  </div>
</Base>
