---
import Base from '../layouts/Base.astro';
import ImageCard from '../components/ImageCard.astro';
import VideoCard from '../components/VideoCard.astro';
import { images, texts, videos, skills, communitySkills, catSlugs, catCounts, excerpt, fmt, pad } from '../lib/data';
import { ui, href, categoryLabels, type Lang } from '../i18n';
import { COUNTER } from '../lib/counter';
import { faqSchema } from '../lib/seo';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const cat = categoryLabels[lang];

const byLikes = [...images].sort((a, b) => b.likes - a.likes);
const popular = byLikes.slice(0, 12);
// One strong example from each of four everyday categories for the hero sheet.
// Skip prompts about people: the hero should not show a real person's likeness.
const heroCats = ['product-brand', 'food-drink', 'poster', 'infographic-ui'];
const people = /\b(portrait|selfie|woman|women|man|men|girl|boy|face|faces|person|people|celebrit\w+|model|actor|actress|singer|rapper|player)\b/i;
// Each tile cycles through a small pool from its category; the first entry is rendered statically.
const heroPools = heroCats
  .map((c) => byLikes.filter((p) => p.cats[0] === c && p.images[0] && !people.test(p.prompt)).slice(0, 6))
  .filter((pool) => pool.length);
const hero = heroPools.map((pool) => pool[0]);
const curated = images.filter((p) => p.source !== 'jau123').slice(0, 8);
const textPicks = texts.slice(0, 8);
const skillPicks = skills.filter((s) => ['pdf', 'pptx', 'xlsx', 'docx', 'frontend-design', 'canvas-design'].includes(s.name));
const words = t.hero.words;
const stats: [number, string, string][] = [
  [images.length, t.hero.statImages, '/images'],
  [videos.length, t.hero.statVideos, '/videos'],
  [texts.length, t.hero.statText, '/text'],
  [skills.length + communitySkills.length, t.hero.statSkills, '/skills'],
];
---

<Base lang={lang} title={t.homeTitle} schema={[faqSchema(t.faq.items)]}>
  <section class="border-b border-ink">
    <div class="wrap grid gap-10 py-10 lg:grid-cols-[1.15fr_1fr] lg:gap-14 lg:py-16">
      <div class="flex flex-col justify-center">
        <p class="label">{t.hero.label}</p>
        <h1 class="display mt-5 text-[clamp(2.6rem,7.2vw,5.6rem)]">
          {/* Explicit spaces: the lines break visually, but search engines read the text run together. */}
          {t.hero.line1}{' '}
          <span class="mt-1 block">
            <mark id="rot" class="inline-block px-[0.12em]">{words[0]}</mark>
          </span>{' '}
          <span class="block">{t.hero.line3}</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">{t.hero.lead(images.length + videos.length + texts.length)}</p>
        <form action={href(lang, '/search')} class="mt-8 flex max-w-xl" role="search">
          <input type="search" name="q" placeholder={t.searchHint} aria-label={t.searchPrompts} class="field min-w-0 flex-1 border-r-0" />
          <button class="btn px-6 text-base">{t.search}</button>
        </form>
        {/* Every number rolls in like an odometer. The last one is live: it is read from the copy counter. */}
        <dl id="stats" class="mt-10 grid grid-cols-2 border-t border-ink sm:grid-cols-5" data-api={COUNTER.url} data-key={COUNTER.key}>
          {
            stats.map(([n, label, path], i) => (
              <a href={href(lang, path)} class:list={['stat group block py-4', i > 0 && 'sm:pl-4', i % 2 === 1 && 'max-sm:pl-4']}>
                <dd class="display text-3xl sm:text-[1.6rem] xl:text-[2.1rem]">
                  <span class="odo group-hover:bg-mark" data-value={n}>{fmt(n)}</span>
                </dd>
                <dt class="label mt-1">{label}</dt>
              </a>
            ))
          }
          <div class="stat col-span-2 py-4 sm:col-span-1 sm:pl-4">
            <dd class="display relative inline-block text-3xl sm:text-[1.6rem] xl:text-[2.1rem]">
              <span id="copied-odo" class="odo">0</span>
            </dd>
            <dt class="label mt-1 flex items-center gap-1.5">
              <span class="relative flex size-2 shrink-0" aria-hidden="true">
                <span class="live-ping absolute inline-flex size-full rounded-full bg-hot/70" />
                <span class="relative inline-flex size-2 rounded-full bg-hot" />
              </span>
              {t.hero.statCopied}
            </dt>
          </div>
        </dl>
      </div>

      {/* Hero sheet: the tiles take turns swapping to another prompt from the same category. */}
      <div id="hero-sheet" class="grid grid-cols-2 gap-3 self-center">
        {
          hero.map((p, i) => (
            <a
              href={href(lang, `/prompt/${p.slug}`)}
              class="tile hero-tile group relative block"
              data-pool={JSON.stringify(heroPools[i].map((x) => [href(lang, `/prompt/${x.slug}`), x.images[0], x.title]))}
            >
              <span class="tile-img aspect-square overflow-hidden">
                <img
                  src={p.images[0]}
                  alt={p.title}
                  referrerpolicy="no-referrer"
                  class="hero-layer is-front"
                  onerror="this.style.visibility='hidden'"
                />
                <img alt="" referrerpolicy="no-referrer" class="hero-layer" aria-hidden="true" />
                <span class="absolute left-0 top-0 z-10 bg-ink px-2 py-1 font-mono text-[11px] text-paper">
                  {pad(i + 1)}
                  <span class="hero-count opacity-60" />
                </span>
                <span class="absolute inset-x-0 bottom-0 z-10 bg-paper/95 px-2.5 py-1.5 font-mono text-[11px] uppercase tracking-[0.1em]">
                  {cat[p.cats[0]]}
                  <span class="hero-bar" aria-hidden="true" />
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="wrap pt-14">
    <div class="sec">
      <span class="label">01</span>
      <h2>{t.secCategories}</h2>
    </div>
    <div class="mt-4 grid sm:grid-cols-2 sm:gap-x-10">
      {
        catSlugs.map((slug) => (
          <a href={href(lang, `/category/${slug}`)} class="row flex items-baseline justify-between gap-4 px-1 !py-3.5">
            <span class="font-display text-xl font-bold tracking-[-0.02em]">{cat[slug]}</span>
            <span class="font-mono text-sm text-muted">{fmt(catCounts[slug])}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="wrap pt-16">
    <div class="sec justify-between">
      <div class="flex items-baseline gap-4">
        <span class="label">02</span>
        <h2>{t.secPopular}</h2>
      </div>
      <a href={href(lang, '/images')} class="link text-sm font-semibold">{t.allImages}</a>
    </div>
    <div class="masonry mt-6">
      {popular.map((p, i) => <ImageCard p={p} lang={lang} eager={i < 4} />)}
    </div>
  </section>

  <section class="wrap pt-12">
    <div class="sec justify-between">
      <div class="flex items-baseline gap-4">
        <span class="label">03</span>
        <h2>{t.secVideos}</h2>
      </div>
      <a href={href(lang, '/videos')} class="link text-sm font-semibold">{t.allVideos}</a>
    </div>
    <div class="mt-6 grid grid-cols-2 gap-x-5 gap-y-7 md:grid-cols-4">
      {videos.slice(0, 8).map((v) => <VideoCard v={v} lang={lang} />)}
    </div>
  </section>

  <section class="wrap pt-12">
    <div class="sec">
      <span class="label">04</span>
      <h2>{t.secCurated}</h2>
    </div>
    <div class="masonry mt-6">
      {curated.map((p) => <ImageCard p={p} lang={lang} />)}
    </div>
  </section>

  <section class="wrap pt-12">
    <div class="sec justify-between">
      <div class="flex items-baseline gap-4">
        <span class="label">05</span>
        <h2>{t.secText}</h2>
      </div>
      <a href={href(lang, '/text')} class="link text-sm font-semibold">{t.allText}</a>
    </div>
    <div class="mt-2 grid md:grid-cols-2 md:gap-x-10">
      {
        textPicks.map((x, i) => (
          <a href={href(lang, `/text-prompt/${x.slug}`)} class="row grid grid-cols-[2.5rem_1fr] gap-x-2 px-1">
            <span class="label pt-1">{pad(i + 1)}</span>
            <span>
              <span class="block font-semibold">{x.title}</span>
              <span class="mt-1 line-clamp-2 block text-sm text-muted">{excerpt(x.prompt, 150)}</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="wrap pt-16">
    <div class="grid border border-ink bg-surface md:grid-cols-[1fr_1.2fr]">
      <div class="border-b border-ink p-6 sm:p-8 md:border-b-0 md:border-r">
        <span class="label">06</span>
        <h2 class="display mt-3 text-3xl sm:text-4xl">{t.skillsTeaser.title}</h2>
        <p class="mt-4 max-w-md leading-relaxed text-muted">{t.skillsTeaser.body}</p>
        <a href={href(lang, '/skills')} class="btn mt-6">{t.skillsTeaser.cta(skills.length + communitySkills.length)}</a>
      </div>
      <ul class="font-mono text-sm">
        {
          skillPicks.map((s) => (
            <li class="border-b border-line last:border-0">
              <a href={href(lang, '/skills')} class="flex items-baseline justify-between gap-4 px-6 py-3 transition-colors hover:bg-mark/60 sm:px-8">
                <span class="font-bold">{s.name}/</span>
                <span class="text-[11px] uppercase tracking-[0.1em] text-muted">{t.skills.licenses[s.license]}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="wrap pt-16">
    <div class="sec">
      <span class="label">07</span>
      <h2>{t.faq.title}</h2>
    </div>
    <div class="mt-2 max-w-3xl">
      {
        t.faq.items.map(([q, a]) => (
          <details class="group border-b border-line">
            <summary class="flex cursor-pointer list-none items-baseline justify-between gap-4 px-1 py-4 font-semibold hover:bg-mark/60 [&::-webkit-details-marker]:hidden">
              {q}
              <span class="font-mono text-muted group-open:hidden" aria-hidden="true">+</span>
              <span class="hidden font-mono text-muted group-open:inline" aria-hidden="true">−</span>
            </summary>
            <p class="px-1 pb-5 leading-relaxed text-muted">{a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="wrap pt-16">
    <div class="flex flex-col gap-5 border border-ink bg-mark p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
      <div>
        <h2 class="display text-2xl sm:text-3xl">{t.support.title}</h2>
        <p class="mt-2 max-w-xl leading-relaxed">{t.support.body}</p>
      </div>
      <a href={href(lang, '/donate')} class="btn shrink-0 hover:!bg-paper"><span class="text-hot" aria-hidden="true">♥</span> {t.support.cta}</a>
    </div>
  </section>
</Base>

<script is:inline define:vars={{ words }}>
  // Odometer numbers in the stats row. Each digit is a column of 0-9 three times over, resting
  // on the middle set: it spins a full turn into place on load, rolls forward when the digit
  // changes (9 to 0 carries on into the next set), then snaps back to the middle set.
  const ROW = 1.25; // em, the height of one digit
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const odometer = (el) => {
    const sr = document.createElement('span');
    sr.className = 'sr-only';
    const reel = document.createElement('span');
    reel.className = 'odo-reel';
    reel.setAttribute('aria-hidden', 'true');
    el.replaceChildren(sr, reel);
    el.classList.add('odo-on');
    const cols = []; // rightmost digit first: { wrap, strip, pos }
    const place = (c, how) => {
      c.strip.style.transition = how;
      c.strip.style.transform = 'translateY(-' + c.pos * ROW + 'em)';
    };
    const column = () => {
      const wrap = document.createElement('span');
      wrap.className = 'relative inline-block';
      const ghost = document.createElement('span');
      ghost.className = 'invisible';
      ghost.textContent = '0';
      const strip = document.createElement('span');
      strip.className = 'absolute inset-x-0 top-0 flex flex-col items-center';
      for (let n = 0; n < 30; n++) {
        const d = document.createElement('span');
        d.style.height = ROW + 'em';
        d.textContent = String(n % 10);
        strip.append(d);
      }
      wrap.append(ghost, strip);
      const c = { wrap, strip, pos: 10 };
      strip.addEventListener('transitionend', () => {
        if (c.pos < 20) return;
        c.pos -= 10;
        place(c, 'none');
      });
      place(c, 'none');
      return c;
    };
    // spin: start every digit at 0 and roll a full turn to its value.
    return (value, spin, delay = 0) => {
      const text = value.toLocaleString('en-US');
      const digits = text.replace(/\D/g, '');
      sr.textContent = text;
      while (cols.length < digits.length) cols.push(column());
      const nodes = [];
      let k = digits.length;
      for (const ch of text) nodes.push(/\d/.test(ch) ? cols[--k].wrap : document.createTextNode(ch));
      reel.replaceChildren(...nodes);
      [...digits].forEach((ch, i) => {
        const c = cols[digits.length - 1 - i];
        const digit = Number(ch);
        if (calm) {
          c.pos = 10 + digit;
          return place(c, 'none');
        }
        if (spin) {
          c.pos = 10;
          place(c, 'none');
        }
        const next = spin ? 20 + digit : c.pos + ((digit - (c.pos % 10) + 10) % 10);
        if (next === c.pos) return;
        // Two frames, so the starting position is painted before the roll begins.
        requestAnimationFrame(() =>
          requestAnimationFrame(() => {
            c.pos = next;
            place(c, spin ? 'transform 1500ms cubic-bezier(0.16, 1, 0.3, 1) ' + (delay + i * 80) + 'ms' : 'transform 500ms cubic-bezier(0.16, 1, 0.3, 1)');
          }),
        );
      });
    };
  };

  const statsEl = document.getElementById('stats');
  if (statsEl) {
    // The four library totals spin in once, one after another, when the row scrolls into view.
    const fixed = [...statsEl.querySelectorAll('.odo[data-value]')].map((el) => ({ value: Number(el.dataset.value), set: odometer(el) }));
    const start = () => fixed.forEach((o, i) => o.set(o.value, true, i * 140));
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        start();
      });
      io.observe(statsEl);
    } else start();

    // The live total: spins in once it has loaded, then steps up one real copy at a time with a "+1".
    const liveEl = document.getElementById('copied-odo');
    const setLive = odometer(liveEl);
    setLive(0, false);
    let shown = 0;
    let target = 0;
    let timer;
    const pop = () => {
      if (calm) return;
      const p = document.createElement('span');
      p.className = 'count-pop pointer-events-none absolute -right-5 -top-1 font-mono text-xs font-bold text-hot';
      p.setAttribute('aria-hidden', 'true');
      p.textContent = '+1';
      liveEl.parentElement.append(p);
      setTimeout(() => p.remove(), 1200);
    };
    const tick = () => {
      const gap = target - shown;
      if (gap <= 0) return;
      if (gap > 20) {
        shown = target;
        return setLive(shown, false);
      }
      setLive(++shown, false);
      pop();
      timer = setTimeout(tick, 700);
    };
    let first = true;
    let last = -Infinity;
    const load = async () => {
      if (document.visibilityState !== 'visible' || performance.now() - last < 60000) return;
      last = performance.now();
      try {
        const r = await fetch(statsEl.dataset.api + '/mt_copy_get', { headers: { apikey: statsEl.dataset.key } });
        const total = Number((await r.json()).total);
        if (!Number.isFinite(total)) return;
        if (first) {
          first = false;
          shown = target = total;
          setLive(total, true, fixed.length * 140);
        } else if (total > target) {
          target = total;
          clearTimeout(timer);
          tick();
        }
      } catch {
        // Offline or blocked: keep what is shown.
      }
    };
    load();
    setInterval(load, 5 * 60000);
    document.addEventListener('visibilitychange', load);
  }

  // Rotate the highlighted word in the headline: the blank being filled.
  const el = document.getElementById('rot');
  if (el && !calm) {
    let i = 0;
    el.style.transition = 'opacity .18s';
    setInterval(() => {
      el.style.opacity = '0';
      setTimeout(() => {
        i = (i + 1) % words.length;
        el.textContent = words[i];
        el.style.opacity = '1';
      }, 180);
    }, 2400);
  }

  // Hero sheet: every few seconds the next tile in turn wipes up to another prompt
  // from its category. Pauses while hovered or when the tab is hidden.
  const sheet = document.getElementById('hero-sheet');
  if (sheet && !calm) {
    const tiles = [...sheet.querySelectorAll('.hero-tile')]
      .map((a) => ({ a, pool: JSON.parse(a.dataset.pool || '[]'), at: 0, layers: [...a.querySelectorAll('.hero-layer')] }))
      .filter((t) => t.pool.length > 1);
    const STEP = 2400;
    let turn = 0;
    let busy = false;
    let hovered = false;
    sheet.addEventListener('mouseenter', () => (hovered = true));
    sheet.addEventListener('mouseleave', () => (hovered = false));
    sheet.addEventListener('focusin', () => (hovered = true));
    sheet.addEventListener('focusout', () => (hovered = false));
    const count = (t) => {
      const c = t.a.querySelector('.hero-count');
      if (c) c.textContent = ' · ' + (t.at + 1) + '/' + t.pool.length;
    };
    tiles.forEach(count);
    const load = (img, src) =>
      new Promise((ok, fail) => {
        img.onload = () => ok();
        img.onerror = () => fail();
        img.style.visibility = '';
        img.src = src;
      });
    const swap = async (t) => {
      // Try the following entries until one loads; drop any that fail.
      const back = t.layers.find((l) => !l.classList.contains('is-front'));
      const front = t.layers.find((l) => l.classList.contains('is-front'));
      for (let tries = 0; tries < t.pool.length - 1; tries++) {
        const next = (t.at + 1) % t.pool.length;
        const [link, src, title] = t.pool[next];
        try {
          await load(back, src);
        } catch {
          t.pool.splice(next, 1);
          if (t.pool.length < 2) return;
          continue;
        }
        t.at = next;
        back.alt = title;
        back.removeAttribute('aria-hidden');
        front.alt = '';
        front.setAttribute('aria-hidden', 'true');
        t.a.href = link;
        tiles.forEach((o) => o.a.classList.toggle('is-live', o === t));
        // The outgoing image stays whole underneath until the wipe has covered it.
        front.classList.add('is-under');
        front.classList.remove('is-front');
        back.classList.add('is-front');
        setTimeout(() => front.classList.remove('is-under'), 900);
        t.a.classList.remove('is-running');
        void t.a.offsetWidth; // restart the progress bar
        t.a.classList.add('is-running');
        count(t);
        return;
      }
    };
    setInterval(async () => {
      if (busy || hovered || document.visibilityState !== 'visible' || !tiles.length) return;
      busy = true;
      await swap(tiles[turn % tiles.length]);
      turn++;
      busy = false;
    }, STEP);
  }
</script>
