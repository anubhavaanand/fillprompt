---
import Base from '../layouts/Base.astro';
import { skills, sources } from '../lib/data';
import { ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const ts = t.skills;
const src = sources.anthropic;
---

<Base lang={lang} title={ts.metaTitle} description={ts.metaDesc}>
  <div class="wrap pt-10">
    <p class="label">{t.collection}</p>
    <h1 class="display mt-2 text-4xl sm:text-6xl">{ts.title}</h1>
    <p class="mt-3 max-w-2xl text-muted">
      {ts.leadA}<code class="bg-mark/50 px-1 font-mono text-sm text-ink">SKILL.md</code>{ts.leadB}
    </p>

    <div class="mt-8 border-t border-ink">
      {
        skills.map((s) => (
          <a href={s.url} target="_blank" rel="noopener noreferrer" class="row grid gap-x-8 gap-y-1 px-1 md:grid-cols-[15rem_1fr_11rem]">
            <span class="font-mono text-[15px] font-bold">{s.name}/</span>
            <span class="line-clamp-3 text-sm leading-relaxed text-muted">{s.description}</span>
            <span class="label md:text-right">
              {ts.licenses[s.license]}
              <span class="ml-1 text-ink">↗</span>
            </span>
          </a>
        ))
      }
    </div>

    <p class="mt-6 max-w-2xl text-sm text-muted">
      {ts.source}: <a href={src.url} target="_blank" rel="noopener noreferrer" class="link font-semibold text-ink">{src.name}</a>
      {ts.by} {src.by}. {ts.note}
    </p>
  </div>
</Base>
